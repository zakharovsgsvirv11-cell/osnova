# Exchange server credentials
# Copy this file to .env and fill in real values:  cp .env.example .env
# SECURITY: Never commit .env — it is in .gitignore
# After creating .env, restrict permissions:  chmod 600 .env

EXCHANGE_SERVER=mail.example.com
EXCHANGE_USERNAME=user@example.com
EXCHANGE_PASSWORD=<your-password>
EXCHANGE_EMAIL=user@example.com

# MCP server settings
MCP_HOST=0.0.0.0
MCP_PORT=8000
